{
    "$schema": "./node_modules/oxlint/configuration_schema.json",
    "plugins": ["typescript", "unicorn", "oxc", "import"],
    "categories": {
        "correctness": "error",
        "suspicious": "error",
        "perf": "warn"
    },
    "env": {
        "browser": true,
        "builtin": true
    },
    "rules": {},
    "overrides": [
        {
            "files": ["e2e/**", "scripts/**"],
            "rules": {
                "no-await-in-loop": "off"
            }
        },
        {
            "files": ["src/prototype/**"],
            "rules": {
                "import/no-unassigned-import": "off"
            }
        }
    ]
}
