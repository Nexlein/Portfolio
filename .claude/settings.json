{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "permissions": {
        "allow": [
            "Bash(npm run typecheck *)",
            "Bash(npm run format *)",
            "Bash(npm run format:check *)",
            "Bash(npm run knip *)",
            "Bash(npm run codemap *)",
            "Bash(npm run cv:pdf *)",
            "Bash(npm run audit *)",
            "Bash(npm outdated *)",
            "Bash(npm ls *)",
            "Bash(npm view *)",
            "Bash(npx prettier *)",
            "Bash(npx oxlint *)",
            "Bash(npx stylelint *)",
            "Bash(npx playwright test *)",
            "Bash(node scripts/codemap.ts *)",
            "Bash(node scripts/format.ts *)",
            "Bash(git ls-files *)",
            "Bash(git rev-parse *)",
            "Bash(git fetch *)",
            "Bash(git pull --ff-only *)",
            "Bash(git switch *)",
            "Bash(gh pr view *)",
            "Bash(gh pr diff *)",
            "Bash(gh pr checks *)",
            "Bash(gh pr list *)",
            "Bash(gh run list *)",
            "Bash(gh run view *)"
        ],
        "ask": [
            "Bash(git switch *--discard-changes*)",
            "Bash(git switch *--force*)",
            "Bash(git switch -f*)",
            "Bash(git switch * -f*)",
            "Bash(git switch -C*)",
            "Bash(git switch * -C*)"
        ]
    }
}
