{
    "name": "nexlein-portfolio",
    "version": "1.0.0",
    "description": "Portfolio of Nielsen COMBE--BRACCIALE (Nexlein), AI & full-stack developer.",
    "scripts": {
        "dev": "vite",
        "build": "tsc && vite build",
        "preview": "vite preview",
        "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json",
        "test": "vitest run",
        "test:e2e": "vite build && playwright test",
        "cv:pdf": "node scripts/cv-pdf.ts",
        "codemap": "node scripts/codemap.ts",
        "lint": "oxlint --type-aware && stylelint \"src/**/*.css\"",
        "lint:fix": "oxlint --type-aware --fix && stylelint \"src/**/*.css\" --fix",
        "format": "git ls-files -z | xargs -0 prettier --ignore-unknown --write",
        "format:check": "git ls-files -z | xargs -0 prettier --ignore-unknown --check",
        "audit": "npm audit --audit-level=high",
        "knip": "knip --config config/knip.json",
        "media": "node scripts/media.ts",
        "media:brand": "node scripts/brand-images.ts",
        "media:video": "bash scripts/optimize-video.sh",
        "prepare": "husky"
    },
    "keywords": [],
    "author": "Nielsen COMBE--BRACCIALE",
    "private": true,
    "type": "module",
    "devDependencies": {
        "@fontsource-variable/schibsted-grotesk": "^5.3.0",
        "@fontsource/ibm-plex-mono": "^5.3.0",
        "@playwright/test": "^1.64.1",
        "@types/node": "^26.6.6",
        "happy-dom": "^21.0.4",
        "husky": "^9.1.7",
        "knip": "^6.44.0",
        "lint-staged": "^17.6.0",
        "oxlint": "^1.90.0",
        "oxlint-tsgolint": "^7.0.2006",
        "prettier": "^3.9.10",
        "stylelint": "^17.16.0",
        "stylelint-config-standard": "^40.0.0",
        "typescript": "^7.0.2",
        "vite": "^8.3.5",
        "vitest": "^5.0.5"
    },
    "engines": {
        "node": "26.x"
    }
}
