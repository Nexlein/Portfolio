{
    "name": "nexlein-portfolio",
    "version": "1.0.0",
    "description": "Nielsen COMBE--BRACCIALE's professional software engineering portfolio.",
    "scripts": {
        "dev": "vite",
        "build": "tsc && vite build",
        "preview": "vite preview",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:e2e": "vite build && playwright test",
        "cv:pdf": "node scripts/cv-pdf.mjs",
        "codemap": "node scripts/codemap.mjs",
        "lint": "oxlint && stylelint \"src/**/*.css\"",
        "lint:fix": "oxlint --fix && stylelint \"src/**/*.css\" --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "audit": "audit-ci --config audit-ci.jsonc",
        "media:posters": "bash scripts/make-posters.sh",
        "media:og": "bash scripts/make-og-images.sh",
        "media:video": "bash scripts/optimize-video.sh",
        "prepare": "husky"
    },
    "keywords": [],
    "author": "Nielsen COMBE--BRACCIALE",
    "license": "ISC",
    "type": "module",
    "devDependencies": {
        "@fontsource/ibm-plex-mono": "^5.3.0",
        "@fontsource/schibsted-grotesk": "^5.3.0",
        "@playwright/test": "^1.63.0",
        "audit-ci": "^7.1.0",
        "happy-dom": "^20.14.5",
        "husky": "^9.1.7",
        "lint-staged": "^17.6.0",
        "oxlint": "^1.87.0",
        "prettier": "^3.9.9",
        "stylelint": "^17.16.0",
        "stylelint-config-standard": "^40.0.0",
        "typescript": "^7.0.2",
        "vite": "^8.3.2",
        "vitest": "^5.0.3"
    },
    "engines": {
        "node": ">=22"
    }
}
