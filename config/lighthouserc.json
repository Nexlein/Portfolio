                "categories:performance": [
                    "error",
                    {
                        "minScore": 0.85
                    }
                ],
                "categories:accessibility": [
                    "error",
                    {
                        "minScore": 0.95
                    }
                ],
                "categories:best-practices": [
                    "error",
                    {
                        "minScore": 0.95
                    }
                ],
                "categories:seo": [
                    "error",
                    {
                        "minScore": 0.95
                    }
                ]
            }
        }
    }
}
