{
    "ci": {
        "collect": {
            "staticDistDir": "./dist",
            "numberOfRuns": 3,
            "url": [
                "http://localhost/index.html",
                "http://localhost/cv.html",
                "http://localhost/projects/zappy.html",
                "http://localhost/fr/index.html",
                "http://localhost/fr/cv.html",
                "http://localhost/fr/projects/zappy.html"
            ]
        },
        "assert": {
