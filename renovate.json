{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": ["config:recommended", ":semanticCommits", "schedule:weekly", "security:minimumReleaseAgeNpm"],
    "baseBranchPatterns": ["dev"],
    "timezone": "Europe/Paris",
    "lockFileMaintenance": {
        "description": "Weekly fresh package-lock.json, so transitive dependencies move too",
        "enabled": true
    },
    "packageRules": [
        {
            "description": "One PR for every npm minor and patch update",
            "matchManagers": ["npm"],
            "matchDepTypes": ["devDependencies"],
            "matchUpdateTypes": ["minor", "patch"],
            "groupName": "npm minor and patch"
        },
        {
            "description": "Raise package.json ranges to the new version, not only the lockfile (a rule of its own: rangeStrategy applies before the update type is known)",
            "matchManagers": ["npm"],
            "matchDepTypes": ["devDependencies"],
            "rangeStrategy": "bump"
        },
        {
            "description": "One PR for every GitHub Actions update",
            "matchManagers": ["github-actions"],
            "groupName": "GitHub Actions",
            "semanticCommitType": "ci"
        },
        {
            "description": "A new Node major moves mise.toml, engines and @types/node together",
            "matchDepNames": ["node", "@types/node"],
            "matchUpdateTypes": ["major"],
            "groupName": "Node"
        },
        {
            "description": "Read partial versions in mise.toml (gitleaks = \"8\") as ranges (any 8.x), not as exact versions (8.0.0)",
            "matchManagers": ["mise"],
            "matchDepNames": ["gitleaks", "actionlint", "shellcheck"],
            "versioning": "npm"
        }
    ]
}
