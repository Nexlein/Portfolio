{
    "extends": ["stylelint-config-standard"],
    "rules": {
        "import-notation": "string",
        "property-no-vendor-prefix": [
            true,
            { "ignoreProperties": ["/backdrop-filter/", "/text-size-adjust/", "/print-color-adjust/"] }
        ],
        "value-keyword-case": ["lower", { "camelCaseSvgKeywords": true, "ignoreKeywords": ["BlinkMacSystemFont"] }]
    }
}
