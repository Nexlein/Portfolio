{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "redirects": [
        {
            "source": "/cv.pdf",
            "destination": "https://github.com/Nexlein/Portfolio/releases/download/cv/Nielsen-Combe-Bracciale-CV-EN.pdf",
            "permanent": false
        },
        {
            "source": "/fr/cv.pdf",
            "destination": "https://github.com/Nexlein/Portfolio/releases/download/cv/Nielsen-Combe-Bracciale-CV-FR.pdf",
            "permanent": false
        },
        {
            "source": "/availability.html",
            "destination": "/#contact",
            "permanent": true
        },
        {
            "source": "/fr/availability.html",
            "destination": "/fr/#contact",
            "permanent": true
        },
        {
            "source": "/projects/:id(myradar|mytop|secured).html",
            "destination": "/#work",
            "permanent": true
        },
        {
            "source": "/fr/projects/:id(myradar|mytop|secured).html",
            "destination": "/fr/#work",
            "permanent": true
        }
    ],
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "Content-Security-Policy",
                    "value": "default-src 'self'; script-src 'self' 'sha256-e+/1YY6y/DLfqg1XZGYoNy7d9XFXXAItjz/zqdSC50I='; style-src 'self'; img-src 'self'; media-src 'self'; font-src 'self'; connect-src 'self'; frame-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests"
                },
                {
                    "key": "X-Content-Type-Options",
                    "value": "nosniff"
                },
                {
                    "key": "X-Frame-Options",
                    "value": "DENY"
                },
                {
                    "key": "Referrer-Policy",
                    "value": "strict-origin-when-cross-origin"
                },
                {
                    "key": "Permissions-Policy",
                    "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
                },
                {
                    "key": "Cross-Origin-Opener-Policy",
                    "value": "same-origin"
                }
            ]
        },
        {
            "source": "/assets/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        },
        {
            "source": "/og-image(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=86400, stale-while-revalidate=604800"
                }
            ]
        },
        {
            "source": "/projects/:id/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=86400, stale-while-revalidate=604800"
                }
            ]
        }
    ]
}
